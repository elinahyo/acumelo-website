          "weight": 0.7,
          "camera": "detail"
        }
      ]
    },
    {
      "text": "Use React and TypeScript for the web workspace, then inspect the Flutter and Dart mobile flow. Keep loading, error, and success states explicit, with a shared contract for the underlying data.",
