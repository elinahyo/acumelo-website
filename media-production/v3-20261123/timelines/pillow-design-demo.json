  "beats": [
    {
      "text": "Let us build interactive exhibition as a coherent visual system. Start with composition and reusable components, then move into motion, materials, and controlled variation.",
      "shots": [
        {
          "app": "aftereffects",
          "title": "Shape the timing and composition",
          "tool": "Adobe After Effects",
          "weight": 1.1
        },
        {
          "app": "cinema4d",
          "title": "Build the camera and material system",
          "tool": "Cinema 4D",
          "weight": 1.35
        },
        {
          "app": "aftereffects",
          "title": "Shape the timing and composition",
          "tool": "Adobe After Effects",
          "weight": 0.7,
          "camera": "detail"
        }
      ]
    },
    {
      "text": "Begin with timing in After Effects and a spatial composition in Cinema 4D. Animate the reveal, inspect the graph editor, and adjust the camera so the installation has a clear focal point.",
      "shots": [
        {
          "app": "aftereffects",
          "stage": 1,
          "weight": 1.2,
          "title": "Animate the layers and keyframes"
        },
        {
          "app": "aftereffects",
          "stage": 2,
          "weight": 0.9,
          "title": "Inspect the graph editor",
          "camera": "detail"
        },
        {
          "app": "cinema4d",
          "stage": 1,
          "weight": 1.2,
          "title": "Inspect the cloner and geometry"
        },
        {
          "app": "cinema4d",
          "stage": 2,
          "weight": 1.4,
          "title": "Review lighting and the rendered scene",
          "split": "aftereffects"
        }
      ]
    },
    {
      "text": "Trace a visual variation through ComfyUI, plan a restrained shot in Higgsfield, and refine the scene in Blender. Resolve connects the cuts and color into one continuous exhibition experience.",
      "shots": [
        {
          "app": "higgsfield",
          "stage": 1,
          "weight": 1.4,
          "title": "Compare camera, lens, and movement"
        },
        {
          "app": "comfyui",
          "stage": 2,
          "weight": 1.7,
          "title": "Trace the generation graph",
          "camera": "detail"
        },
        {
          "app": "blender",
          "stage": 2,
          "weight": 0.9,
          "title": "Inspect the scene and asset structure"
        },
        {
          "app": "resolve",
          "stage": 2,
          "weight": 1.2,
          "title": "Edit the sequence and sound"
        }
      ]
    },
    {
      "text": "Adapt the work into generative installation. Compare formats side by side, preview the movement, and review the final experience at the size people will actually see.",
      "shots": [
